        <result property="applicantOfficePhone" column="applicant_office_phone" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="quertyPageListWhere">
        where t1.deleted_flag = 0
        <if test="brand != null and brand != ''">
            AND t2.brand like concat('%',#{brand},'%')
        </if>
        <if test="model != null and model != ''">
            AND t2.model like concat('%',#{model},'%')
        </if>
        <if test="auditStatus != null and auditStatus != ''">
            AND t1.audit_status = #{auditStatus}
        </if>
        <if test="createTimeStart != null">
            AND t1.create_time >= #{createTimeStart}
        </if>
        <if test="createTimeEnd != null">
            AND t1.create_time &lt;= #{createTimeEnd}
        </if>
        <if test=" license != null and license != ''">
            AND t2.license like concat('%',#{license},'%')
        </if>
        <if test=" communityId != null and communityId != ''">
            AND t1.community_id = #{communityId}
        </if>
        <if test="userId != null and userId != ''">
            <!-- 这里是查询轮到此人审批的记录 -->
            AND (t1.repair_id in (
            select prff1.repair_id
            from pubcar_repair_form_flow prff1
            left join pubcar_repair_form_flow prff2 on prff1.flow_index = prff2.flow_index + 1 and prff1.repair_id = prff2.repair_id
            where find_in_set(#{userId},prff1.user_id)  and (prff2.`status` = '2' or prff2.`status` is null) and prff1.`status` = '1')
            OR t1.applicant_id = #{userId})
        </if>
    </sql>

    <select id="quertyPageList" parameterType="com.java110.dto.pubCar.repaorForm.PubcarRepairFormWhereDto" resultType="com.java110.dto.pubCar.repaorForm.PubcarRepairFormDto" >
        select t1.repair_id repairId, t1.repair_fees repairFees, t1.audit_status auditStatus ,t1.applicant_id applicantId, us.name applicantName,
        t1.create_time createTime, us.tel applicantPhone, t1.pubcar_custodian_office_phone pubcarCustodianOfficePhone,
        t1.applicant_office_phone applicantOfficePhone,t1.car_id carId , t2.key_cabinet keyCabinet, t2.license license, t1.ftp_json ftpJson,
        t2.brand brand, t2.model model, t1.pubcar_custodian_id  pubcarCustodianId ,us2.tel pubcarCustodianPhone, us2.name pubcarCustodianName,
        t1.is_traffic_accident isTrafficAccident, t1.is_repair isRepair, t1.repair_rel_proposal repairRelProposal, t1.repair_rel_confirm repairRelConfirm,
        t1.remark remark,if(t3.status = 4 and t3.flow_index &lt;&gt; 0, t3.flow_index - 1, if(t3.flow_step = 0, 0, t3.flow_index+1)) flowIndex, t2.car_type carType,t1.flow_step flowStep,
        CASE t2.car_type
        WHEN 1 THEN '7座以下小客车'
        WHEN 2 THEN '7座（含）以上小客车'
        WHEN 3 THEN '货车'
        WHEN 4 THEN '摩托车'
        WHEN 5 THEN '其它机动车'
        ELSE '其它' END carTypeName
        from pubcar_repair_form t1
        left join u_user us on us.user_id = t1.applicant_id
        left join u_user us2 on us2.user_id = t1.pubcar_custodian_id
        left join pubcar_car t2 on t1.car_id = t2.car_id
        left join pubcar_repair_form_flow t3 on t1.repair_id = t3.repair_id and t1.flow_step = t3.flow_step
        <include refid="quertyPageListWhere"></include>
        order by t1.create_time desc
        <if test="page != -1 and page != null ">
            limit #{page}, #{row}
        </if>
    </select>

    <select id="quertyPageCount" resultType="int" parameterType="com.java110.dto.pubCar.repaorForm.PubcarRepairFormWhereDto">
        select count(1) `count`
        from pubcar_repair_form t1
        left join pubcar_car t2 on t1.car_id = t2.car_id
        <include refid="quertyPageListWhere"></include>
    </select>

