<mapper namespace="pubcarRepairFormDaoImpl">
    <resultMap id="BaseResultMap" type="com.java110.entity.pubcar.PubcarRepairForm">
        <!--@Table -->
        <result property="carId" column="car_id" jdbcType="VARCHAR"/>
        <result property="repairFees" column="repair_fees" jdbcType="NUMERIC"/>
        <result property="remark" column="remark" jdbcType="VARCHAR"/>
        <result property="deletedFlag" column="deleted_flag" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="repairId" column="repair_id" jdbcType="VARCHAR"/>
        <result property="ftpJson" column="ftp_json" jdbcType="VARCHAR"/>
        <result property="communityId" column="community_id" jdbcType="VARCHAR"/>
        <result property="applicantId" column="applicant_id" jdbcType="VARCHAR"/>
        <result property="pubcarCustodianOfficePhone" column="pubcar_custodian_office_phone" jdbcType="VARCHAR"/>
        <result property="pubcarCustodianId" column="pubcar_custodian_id" jdbcType="VARCHAR"/>
        <result property="isTrafficAccident" column="is_traffic_accident" jdbcType="VARCHAR"/>
        <result property="isRepair" column="is_repair" jdbcType="VARCHAR"/>
        <result property="repairRelProposal" column="repair_rel_proposal" jdbcType="VARCHAR"/>
        <result property="repairRelConfirm" column="repair_rel_confirm" jdbcType="VARCHAR"/>
