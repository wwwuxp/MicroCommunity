<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="attendanceNoonRecordServiceDaoImpl">

    <!-- 查询中午考勤列表 -->
    <select id="queryAttendanceNoonRecords" parameterType="com.java110.dto.attendance.AttendanceNoonRecordDto" resultType="com.java110.vo.api.attendanceNoonRecord.ApiAttendanceNoonRecordDataVo">
        SELECT id, department, `position`, `name`, attendance_date attendanceDate,
        DATE_FORMAT(leave_time, '%H:%i') leaveTime,
        DATE_FORMAT(back_time, '%H:%i') backTime, `type`
        FROM attendance_noon_record
        <where>
            <if test="name != null and name != ''">
                `name` LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="department != null and department != ''">
                AND department LIKE CONCAT('%', #{department}, '%')
            </if>
            <if test="position != null and position != ''">
                AND `position` LIKE CONCAT('%', #{position}, '%')
            </if>
            <if test="type != null and type == 1">
                AND (`type` = 1 or `type` = 3)
            </if>
            <if test="type != null and type == 2">
                AND `type` = 2
            </if>
            <if test="startDate != null">
                AND attendance_date >= #{startDate}
            </if>
            <if test="endDate != null">
                <![CDATA[AND attendance_date <= #{endDate}]]>
            </if>
        </where>
        ORDER BY attendance_date DESC, id
        <if test="page != -1 and page != null ">
            limit #{page}, #{row}
        </if>
    </select>

    <!-- 查询中午考勤数量 -->
    <select id="queryAttendanceNoonRecordsCount" parameterType="com.java110.dto.attendance.AttendanceNoonRecordDto" resultType="int">
        SELECT COUNT(*) count
        FROM attendance_noon_record
        <where>
            <if test="name != null and name != ''">
                `name` LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="department != null and department != ''">
                AND department LIKE CONCAT('%', #{department}, '%')
            </if>
            <if test="position != null and position != ''">
                AND `position` LIKE CONCAT('%', #{position}, '%')
            </if>
            <if test="type != null and type == 1">
                AND (`type` = 1 or `type` = 3)
            </if>
            <if test="type != null and type == 2">
                AND `type` = 2
            </if>
            <if test="startDate != null">
                AND attendance_date >= #{startDate}
            </if>
            <if test="endDate != null">
                <![CDATA[AND attendance_date <= #{endDate}]]>
            </if>
        </where>
    </select>

</mapper>