<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java110.ext.mapper.DemoMapper">

    <resultMap id="BaseResultMap" type="com.java110.ext.pojo.DemoPo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status_cd" property="statusCd"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user" property="createUser"/>
        <result column="update_user" property="updateUser"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, description, status_cd, create_time, update_time, create_user, update_user
    </sql>

    <!-- 自定义查询条件示例 -->
    <select id="queryDemoList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ext_demo
        WHERE status_cd = '0'
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
