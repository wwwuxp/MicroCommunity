<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java110.front.mapper.AttendanceNonWorkDayMapper">

    <select id="selectCountByDate" resultType="java.lang.Integer">
        select count(1) from attendance_non_work_day where #{attendanceDate} between start_date and end_date
    </select>
</mapper>